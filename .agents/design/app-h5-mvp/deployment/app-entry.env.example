# AppEntry H5 生产环境映射示例。
# 本文件只作为键名和格式参考；正式值必须由 Secret Manager/CI/CD 注入，不得提交真实 Secret。

APP_ENTRY_ENABLED=true
APP_ENTRY_APP_KEY=customer-service
APP_ENTRY_APP_ID=507f1f77bcf86cd799439011

APP_ENTRY_BRAND_NAME=Business Assistant
APP_ENTRY_BRAND_DESCRIPTION=Business mobile assistant
APP_ENTRY_BRAND_LOGO=https://business.example.com/brand/logo.png
APP_ENTRY_BRAND_FAVICON=https://business.example.com/brand/favicon.ico
APP_ENTRY_PRIMARY_COLOR=#3370FF
APP_ENTRY_SUPPORT_URL=https://business.example.com/support
APP_ENTRY_PRIVACY_URL=https://business.example.com/privacy
APP_ENTRY_TERMS_URL=https://business.example.com/terms

# 至少 32 位高强度随机值；只能由业务 APP 服务端和 FastGPT 服务端持有。
APP_ENTRY_AUTH_CODE_SECRET=replace-with-at-least-32-random-characters
APP_ENTRY_AUTH_CODE_TTL_SECONDS=60

# 正式 WebView 必须使用 HTTPS，并启用 Secure Cookie。
FE_DOMAIN=https://business.example.com
AUTH_COOKIE_SECURE=true

# 非根路径部署时填写，例如 /ai；根路径留空。
NEXT_PUBLIC_BASE_URL=
