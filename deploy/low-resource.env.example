# FastGPT 4 vCPU / 8 GiB 低资源部署参数
#
# 将本文件复制为部署目录中的 .env 后执行：
#   docker compose pull
#   docker compose up -d
#
# Docker Compose 会自动读取同目录的 .env。不要把生产密码、Token 或密钥写入本文件。

# FastGPT App
# 可选：指向本次构建并发布的 App 镜像，例如：
# FASTGPT_APP_IMAGE=ghcr.io/zeroven0205-spec/fastgpt:v4.17.0-low-resource.20260916
FASTGPT_APP_MAX_OLD_SPACE_SIZE=2048
FASTGPT_APP_MEMORY_LIMIT=3g
FASTGPT_APP_CPUS=2.5
FASTGPT_APP_PIDS_LIMIT=512
FASTGPT_APP_DB_MAX_LINK=20

# Shared MongoDB/Redis connection pool used by App and Plugin
FASTGPT_SHARED_DB_MAX_LINK=20

# Redis: maxmemory should leave room for Redis overhead and AOF rewrite.
FASTGPT_REDIS_MAX_MEMORY=1gb
FASTGPT_REDIS_MEMORY_LIMIT=1.25g

# Code Sandbox: keep the feature, but use a small worker pool.
FASTGPT_CODE_SANDBOX_MEMORY_LIMIT=768m
FASTGPT_CODE_SANDBOX_CPUS=1
FASTGPT_CODE_SANDBOX_PIDS_LIMIT=128
FASTGPT_SANDBOX_POOL_SIZE=2
FASTGPT_SANDBOX_MAX_MEMORY_MB=256
FASTGPT_SANDBOX_MAX_TIMEOUT=60000
FASTGPT_SANDBOX_MAX_OUTPUT_MB=10

# Knowledge-base worker concurrency.
FASTGPT_DATASET_PARSE_MAX_PROCESS=2
FASTGPT_VECTOR_MAX_PROCESS=2
FASTGPT_QA_MAX_PROCESS=2
FASTGPT_VLM_MAX_PROCESS=2

# Vector-search CPU trade-off. Increase after benchmarking recall if needed.
FASTGPT_HNSW_EF_SEARCH=80
FASTGPT_HNSW_MAX_SCAN_TUPLES=50000

# Production logging. Keep OTEL disabled unless the collector is external.
FASTGPT_LOG_CONSOLE_LEVEL=info
FASTGPT_LOG_ENABLE_OTEL=false

# Agent Sandbox is intentionally disabled on this machine.
# To enable it, use the agent-sandbox Compose profile and follow the deployment plan.
FASTGPT_AGENT_SANDBOX_PROVIDER=
FASTGPT_AGENT_SANDBOX_CPU_COUNT=1
FASTGPT_AGENT_SANDBOX_MEMORY_MIB=1024
FASTGPT_AGENT_SANDBOX_STORAGE_SIZE_GI=1
